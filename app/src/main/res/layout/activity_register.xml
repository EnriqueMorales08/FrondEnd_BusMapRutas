<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/registro_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOLICITUD DE REGISTRO"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginTop="40dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Sección de fotos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Documentos requeridos"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Foto personal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@drawable/rectangle1"
            android:backgroundTint="#F8F9FA"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgFoto"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/agregar"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/orange"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto personal"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto tuya con tu DNI"
                    android:textColor="#666666"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSeleccionarFoto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Seleccionar"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:backgroundTint="@color/orange"
                android:minWidth="80dp"/>
        </LinearLayout>

        <!-- DNI Frontal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@drawable/rectangle1"
            android:backgroundTint="#F8F9FA"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgDniAnverso"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/cargando"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/orange"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNI - Parte frontal"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto clara del frente de tu DNI"
                    android:textColor="#666666"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSeleccionarDniFrente"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Seleccionar"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:backgroundTint="@color/orange"
                android:minWidth="80dp"/>
        </LinearLayout>

        <!-- DNI Reverso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@drawable/rectangle1"
            android:backgroundTint="#F8F9FA"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgDniReverso"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/cargando"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/orange"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNI - Parte posterior"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto clara del reverso de tu DNI"
                    android:textColor="#666666"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSeleccionarDniReverso"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Seleccionar"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:backgroundTint="@color/orange"
                android:minWidth="80dp"/>
        </LinearLayout>

        <!-- Datos personales -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos personales"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Usuario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/retangle"
            android:backgroundTint="@color/orange"
            android:hint="Ingresa tu usuario..."
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000" />

        <!-- DNI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DNI:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etDni"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rectangle1"
            android:hint="Ingresa tu numero de dni..."
            android:backgroundTint="@color/orange"
            android:inputType="number"
            android:maxLength="8"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000" />

        <!-- Celular -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numero de telefono:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etCelular"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/orange"
            android:layout_marginTop="8dp"
            android:background="@drawable/rectangle1"
            android:hint="Ingresa tu número de telefono..."
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000"/>

        <!-- Correo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo electrónico:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/orange"
            android:background="@drawable/retangle"
            android:hint="Ingresa tu correo electronico..."
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/orange"
            android:layout_marginTop="8dp"
            android:background="@drawable/rectangle1"
            android:hint="Ingresa una contraseña..."
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000"  />

        <!-- Confirmar Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etConfirmarPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/orange"
            android:background="@drawable/rectangle1"
            android:hint="Confirma tu contraseña..."
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#000000" />

        <!-- Botón Registrar -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/orange"
            android:text="INGRESAR SOLICITUD"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
